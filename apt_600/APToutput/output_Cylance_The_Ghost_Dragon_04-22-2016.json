      "evidence_type": "report_text",
      "report_id": "Cylance_The_Ghost_Dragon(04-22-2016)",
      "locator": {
        "page": 3,
        "section": "body",
        "sentence_id": "p3_s1"
      },
      "text": "In a more recent version of the modified Gh0st RAT malware, Ghost Dragon implemented dynamic packet flags which change the first five bytes of the header in every login request with the controller.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
