        "sentence_id": "p1_s4"
      },
      "text": "Background on KASPERAGENT KASPERAGENT is Microsoft Windows malware used in efforts targeting users in the United States, Israel, Palestinian Territories, and Egypt since July 2015.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
