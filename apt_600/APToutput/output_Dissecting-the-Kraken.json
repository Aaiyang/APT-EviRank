      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s2"
      },
      "text": "The G DATA security solutions detect the malicious document (08E834B6D4123F0AEA27D042FCEAF992) as Exploit.CVE-2012-0158.AH and G DATA’s proactive Exploit Protection technology also prevents the attack before the PC can be infected.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
