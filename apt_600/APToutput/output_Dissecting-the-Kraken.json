      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s1"
      },
      "text": "In this case, the attachment is a Microsoft Word document which tries to exploit the vulnerability described in CVE-2012-0158 in order to drop and execute malware dubbed “Kraken HTTP”.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
