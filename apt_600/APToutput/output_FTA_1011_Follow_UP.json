      "locator": {
        "page": 1,
        "section": "rule",
        "sentence_id": "p1_r1"
      },
      "text": "Previous reporting, ref: Fidelis Threat Advisory (FTA) #1011 dated 15 Jan 2014, introduced a malware system comprised of multiple files that reflected a means for intruders to discover and retrieve data from disparate computer systems via removable storage devices. Analysis of the system relied on the availability of two files named netsat.exe and netui3.dll. Netsat.exe functioned as a master application affording intruders the ability, in a selective and controlled manner, to infest removable devices with an agent application in the form of netui3.dll, aka",
      "language": "en",
      "confidence": 0.98,
      "note": "rule or indicator snippet evidence",
      "source": "document"
    },
