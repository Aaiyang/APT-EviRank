      "locator": {
        "page": 7,
        "section": "body",
        "sentence_id": "p7_s2"
      },
      "text": "Logs and proxy servers should be checked for communication with the IP addresses with which the malware communicates: 83.170.33.60 83.170.33.37",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_15",
      "evidence_type": "report_text",
