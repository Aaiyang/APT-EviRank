      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s3"
      },
      "text": "Gholee Our investigation of the Gholee malware started following a detection of a suspicious )le that was sent in an email to an undisclosed recipient.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
