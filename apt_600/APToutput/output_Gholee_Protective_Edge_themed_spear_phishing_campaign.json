      "locator": {
        "page": 4,
        "section": "rule",
        "sentence_id": "p4_r1"
      },
      "text": "When run, the DLL )le is communicating with a Kuwait based IP address: 83.170.33.60, owned by German company iABG Mbh, which provides satellite communication services.",
      "language": "en",
      "confidence": 0.98,
      "note": "rule or indicator snippet evidence",
      "source": "document"
    },
    {
