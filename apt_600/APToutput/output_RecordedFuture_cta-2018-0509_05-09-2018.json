      "locator": {
        "page": 11,
        "section": "body",
        "sentence_id": "p11_s5"
      },
      "text": "Throughout April, Iran’s CSRI simultaneously demonstrated an increased interest in the Philippine Department of Science & Technology (DOST).",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
