      "locator": {
        "page": 12,
        "section": "body",
        "sentence_id": "p12_s1"
      },
      "text": "CSRI was also observed in a large number of events dispatching the Parsijoo bot to crawl websites of interest.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
