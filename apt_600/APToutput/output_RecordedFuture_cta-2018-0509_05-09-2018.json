      "locator": {
        "page": 12,
        "section": "body",
        "sentence_id": "p12_s3"
      },
      "text": "During our research, we noted repeated crawls of a specialist Canadian-Iranian immigration website, www.itc-canada[.]com , using Parsijoo bot from CSRI IP ranges.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
