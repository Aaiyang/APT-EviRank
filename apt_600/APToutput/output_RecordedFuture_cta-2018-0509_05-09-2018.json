      },
      "text": "IHUO 78.39.164.160 78.39.164.167 IR AS12880-MNT 2015-09-05T04:48:32Z Source: RIPE NCC database, ripe.net.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
