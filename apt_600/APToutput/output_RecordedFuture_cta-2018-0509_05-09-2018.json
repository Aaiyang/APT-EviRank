      },
      "text": "xman_1365_x created an Ashiyane profile in 2010.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_56",
      "evidence_type": "report_text",
      "report_id": "RecordedFuture_cta-2018-0509(05-09-2018)",
      "locator": {
        "page": 9,
        "section": "body",
        "sentence_id": "p9_s3"
      },
      "text": "Finally, according to Insikt Group’s source, Iranian contractor ITSEC specifically employed hackers from the respective online forums Simorgh and Delta Security.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_61",
      "evidence_type": "report_text",
      "report_id": "RecordedFuture_cta-2018-0509(05-09-2018)",
      "locator": {
        "page": 10,
        "section": "body",
        "sentence_id": "p10_s5"
      },
      "text": "The institute commands a significant proportion of the university’s allocated IP space, with no fewer than eight /24 IP ranges registered to the CSRI in Iran, according to regional RIPE NCC records.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
