      "locator": {
        "page": 16,
        "section": "body",
        "sentence_id": "p16_s1"
      },
      "text": "The above is known to be true for Notepad3.exe, Notepad4.exe, and notepad10.exe.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
