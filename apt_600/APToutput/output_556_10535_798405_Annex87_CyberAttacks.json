      "locator": {
        "page": 30,
        "section": "body",
        "sentence_id": "p30_s3"
      },
      "text": "Starting with the Russian hacker forum Xaker.ru ( hacker.ru ), investigators found a posting encouraging would- be cyber militia members to enlist at a private, password-protected online forum called StopGeorgia.ru.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
