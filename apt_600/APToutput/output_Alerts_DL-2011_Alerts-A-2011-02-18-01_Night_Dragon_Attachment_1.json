  "evidences": [
    {
      "id": "ev_2",
      "evidence_type": "report_text",
      "report_id": "Alerts DL-2011 Alerts-A-2011-02-18-01 Night Dragon Attachment 1",
      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s2"
      },
      "text": "The following framework provides two sets of prioritized measures and countermeasures that may be useful to prevent traffic to and from known “command and control” (C&C) servers and domains, and identify the presence of Night Dragon activity on specific systems.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_5",
      "evidence_type": "report_text",
      "report_id": "Alerts DL-2011 Alerts-A-2011-02-18-01 Night Dragon Attachment 1",
      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s1"
      },
      "text": "Modify Intrusion Detection Systems (IDS), Intrusion Prevention Systems (IPS), and other deep-packet inspection tools to detect and alert on network traffic associated with Night Dragon activity.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_6",
      "evidence_type": "report_text",
      "report_id": "Alerts DL-2011 Alerts-A-2011-02-18-01 Night Dragon Attachment 1",
      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s2"
      },
      "text": "Backdoor beacon, identified by a 5-second interval with an initial packet with the pattern: “\\x01\\x50[\\x00-\\xff]+\\x68\\x57\\x24\\x13.” iii.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_7",
      "evidence_type": "report_text",
      "report_id": "Alerts DL-2011 Alerts-A-2011-02-18-01 Night Dragon Attachment 1",
      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s3"
      },
      "text": "Some commercially available IDS / IPS signatures have also been updated to include Night Dragon detection.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
