      "evidence_type": "report_text",
      "report_id": "Symantec_Taiwan-targeted-cyberespionage-Trojan(03-29-2016)",
      "locator": {
        "page": 2,
        "section": "rule",
        "sentence_id": "p2_r1"
      },
      "text": "http://classic-blog.[REDACTED DOMAIN 1].com/nasyzk/20002630 http://nasyzk.[REDACTED DOMAIN 2].net/blog/post/251315428",
      "language": "en",
      "confidence": 0.98,
      "note": "rule or indicator snippet evidence",
      "source": "document"
    },
    {
      "id": "ev_63",
      "evidence_type": "report_text",
      "report_id": "Symantec_Taiwan-targeted-cyberespionage-Trojan(03-29-2016)",
      "locator": {
        "page": 5,
        "section": "rule",
        "sentence_id": "p5_r1"
      },
      "text": "website (classic-blog.[REDACTED DOMAIN 1].com) but also used the same URL (classic- blog.[REDACTED DOMAIN 1].com /nasyzk/[ENCODED TEXT]) to obtain the encrypted C&C configuration.",
      "language": "en",
