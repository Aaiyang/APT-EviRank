      },
      "text": "Paolo Palumbo Senior Researcher Security Response F-Secure Labs Twitter: @paolo_3_1415926 Contact F-Secure Incident Response irt@f-secure.com",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
