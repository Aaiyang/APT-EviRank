    {
      "id": "ev_1",
      "evidence_type": "report_text",
      "report_id": "PaloAlto_TrackingElirksJapanSimilaritiesPreviousAttacks(06-23-2016)",
      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s1"
      },
      "text": "Kaoru Hayashi A recent, well-publicized attack on a Japanese business involved two malware families, PlugX and Elirks, that were found during the investigation.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_2",
      "evidence_type": "report_text",
      "report_id": "PaloAlto_TrackingElirksJapanSimilaritiesPreviousAttacks(06-23-2016)",
      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s2"
      },
      "text": "PlugX has been used in a number of attacks since first being discovered in 2012, and we have published several articles related to its use, including an analysis of an attack campaign targeting Japanese companies .",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_3",
      "evidence_type": "report_text",
      "report_id": "PaloAlto_TrackingElirksJapanSimilaritiesPreviousAttacks(06-23-2016)",
      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s3"
      },
      "text": "Elirks, less widely known than PlugX, is a basic backdoor Trojan, first discovered in 2010, that is primarily used to steal information from compromised systems.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_7",
      "evidence_type": "report_text",
      "report_id": "PaloAlto_TrackingElirksJapanSimilaritiesPreviousAttacks(06-23-2016)",
      "locator": {
