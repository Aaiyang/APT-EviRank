      "locator": {
        "page": 3,
        "section": "body",
        "sentence_id": "p3_s2"
      },
      "text": "After decrypting itself and obtaining the addresses of some functions exported by kernel32.dll, it decrypts and drops the payload in the %TEMP% directory in a file named “a.l” which is subsequently loaded by calling kernel32!LoadLibraryA.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_26",
      "evidence_type": "report_text",
