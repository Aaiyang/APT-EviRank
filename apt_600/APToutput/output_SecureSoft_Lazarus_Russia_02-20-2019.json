      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s4"
      },
      "text": "The VBS script downloads a CAB file from the server in the download zone, extracts the embedded EXE file (KEYMARBLE) with the Windows “expand.exe” utility and finally executes it.",
      "language": "en",
      "confidence": 0.95,
