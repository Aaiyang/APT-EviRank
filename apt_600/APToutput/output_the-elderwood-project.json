      "locator": {
        "page": 7,
        "section": "body",
        "sentence_id": "p7_s1"
      },
      "text": "Three zero-day exploits, CVE-2012-0779, CVE-2012-1875, and CVE- 2012-1889 have all been used within a 30-day period to serve up back door Trojans from compromised websites.",
      "language": "en",
      "confidence": 0.95,
