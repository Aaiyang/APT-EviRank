      },
      "text": "Going back in time, the Hydraq Trojan also displayed this obfuscation.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_80",
      "evidence_type": "report_text",
