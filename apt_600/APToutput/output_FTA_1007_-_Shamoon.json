      },
      "text": "Threat Overview According to community write-ups, the Shamoon malware appears to have been deployed against a couple of entities on or about August 15, 2012.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
