      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s10"
      },
      "text": "This file in turn executes \" item3.xml \", which creates a reverse shell connecting to \" redacted[.]redacted[.]com \" over port 443.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
