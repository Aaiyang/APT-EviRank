      "locator": {
        "page": 8,
        "section": "body",
        "sentence_id": "p8_s3"
      },
      "text": "Trilog.exe took one option from the command line, which was a single IP address of the target Triconex device.",
      "language": "en",
      "confidence": 0.95,
