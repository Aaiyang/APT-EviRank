      "evidence_type": "report_text",
      "report_id": "Fireeye_ICS-Attack-Framework-TRITON(12-14-2017)",
      "locator": {
        "page": 8,
        "section": "body",
        "sentence_id": "p8_s6"
      },
      "text": "If the controller was in a running state, trilog.exe encoded the two payload files inject.bin and imain.bin and passed them to the communication libraries to be appended to the controller’s program memory and execution table.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
