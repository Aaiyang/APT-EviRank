        "section": "body",
        "sentence_id": "p2_s4"
      },
      "text": "Link to StealthGenie Several actors involved in Operation C­Major have been rather careless in the past, leaving behind numerous digital traces on the Internet.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
