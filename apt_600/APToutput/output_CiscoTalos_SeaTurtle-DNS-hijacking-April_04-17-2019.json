        "page": 10,
        "section": "body",
        "sentence_id": "p10_s3"
      },
      "text": "We believe that the Sea Turtle campaign continues to be highly successful for several reasons.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_96",
      "evidence_type": "report_text",
      "report_id": "CiscoTalos_SeaTurtle-DNS-hijacking-April(04-17-2019)",
      "locator": {
        "page": 10,
        "section": "body",
        "sentence_id": "p10_s8"
      },
      "text": "The threat actors also used an interesting techniques called certificate impersonation.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_98",
      "evidence_type": "report_text",
      "report_id": "CiscoTalos_SeaTurtle-DNS-hijacking-April(04-17-2019)",
      "locator": {
