      "locator": {
        "page": 6,
        "section": "body",
        "sentence_id": "p6_s10"
      },
      "text": "During 2019, we observe the following name servers being used in support of the Sea Turtle campaign:",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
