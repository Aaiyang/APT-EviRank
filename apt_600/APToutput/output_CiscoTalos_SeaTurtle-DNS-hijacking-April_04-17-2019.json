      },
      "text": "Domain Active Timeframe ns1[.]intersecdns[.]com March - April 2019 ns2[.]intersecdns[.]com March - April 2019 ns1[.]lcjcomputing[.]com January 2019 ns2[.]lcjcomputing[.]com January 2019",
      "language": "en",
      "confidence": 0.95,
