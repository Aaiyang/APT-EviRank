  "evidences": [
    {
      "id": "ev_2",
      "evidence_type": "report_text",
      "report_id": "CiscoTalos_SeaTurtle-DNS-hijacking-April(04-17-2019)",
      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s2"
      },
      "text": "While this incident is limited to targeting primarily national security organizations in the Middle East and North Africa, and we do not want to overstate the consequences of this specific campaign, we are concerned that the success of this operation will lead to actors more broadly attacking the global DNS system.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_5",
      "evidence_type": "report_text",
      "report_id": "CiscoTalos_SeaTurtle-DNS-hijacking-April(04-17-2019)",
      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s1"
      },
      "text": "Cisco Talos has discovered a new cyber threat campaign that we are calling \"Sea Turtle,\" which is targeting public and private entities, including national security organizations, located primarily in the Middle East and North Africa.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_15",
      "evidence_type": "report_text",
      "report_id": "CiscoTalos_SeaTurtle-DNS-hijacking-April(04-17-2019)",
      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s11"
      },
      "text": "The Sea Turtle campaign almost certainly poses a more severe threat than DNSpionage given the actor's methodology in targeting various DNS registrars and registries.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_38",
      "evidence_type": "report_text",
      "report_id": "CiscoTalos_SeaTurtle-DNS-hijacking-April(04-17-2019)",
      "locator": {
        "page": 4,
        "section": "body",
        "sentence_id": "p4_s5"
      },
      "text": "The diagram below illustrates how we believe the actors behind the Sea Turtle campaign used DNS hijacking to achieve their end goals.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_51",
      "evidence_type": "report_text",
