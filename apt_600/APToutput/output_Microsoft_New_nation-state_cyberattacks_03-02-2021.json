      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s8"
      },
      "text": "Exchange Server is primarily used by business customers, and we have no evidence that Hafnium’s activities targeted individual consumers or that these exploits impact other Microsoft products.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
