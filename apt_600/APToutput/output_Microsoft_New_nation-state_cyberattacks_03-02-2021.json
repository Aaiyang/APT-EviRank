      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s3"
      },
      "text": "Historically, Hafnium primarily targets entities in the United States for the purpose of exfiltrating information from a number of industry sectors, including infectious disease researchers, law firms, higher education institutions, defense contractors, policy think tanks and NGOs.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_8",
      "evidence_type": "report_text",
