    {
      "id": "ev_76",
      "evidence_type": "report_text",
      "report_id": "ZoxPNG_Full_Analysis-Final",
      "locator": {
        "page": 12,
        "section": "body",
        "sentence_id": "p12_s2"
      },
      "text": "The command handler uses the payload section of the data blob (the section following the CommandHeader and CommandData structures) as a NULL-terminating string containing the full filename and path of the file to delete.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_79",
      "evidence_type": "report_text",
      "report_id": "ZoxPNG_Full_Analysis-Final",
      "locator": {
        "page": 12,
        "section": "body",
        "sentence_id": "p12_s5"
      },
      "text": "The command handler uses the payload section of the data blob (the section following the CommandHeader and CommandData structures) as a NULL-terminating string containing the both the full filename and path of the file to rename as well as the full filename and path of the new name for the file.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
