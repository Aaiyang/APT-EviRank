      "locator": {
        "page": 3,
        "section": "rule",
        "sentence_id": "p3_r2"
      },
      "text": "sc create hdv_725x type= kernel start= demand binpath= %WINDOWS%\\system32\\hdv_725x.sys",
      "language": "en",
      "confidence": 0.98,
      "note": "rule or indicator snippet evidence",
      "source": "document"
