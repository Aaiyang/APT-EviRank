      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s4"
      },
      "text": "The Longhorn group shares some of the same cryptographic protocols specified in the Vault 7 documents, in addition to following leaked guidelines on tactics to avoid detection.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
