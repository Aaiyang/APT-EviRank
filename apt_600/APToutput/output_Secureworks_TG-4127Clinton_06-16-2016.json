      "locator": {
        "page": 2,
        "section": "body",
        "sentence_id": "p2_s2"
      },
      "text": "During this period, TG-4127 created 213 short links targeting 108 email addresses on the hillaryclinton.com domain.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
