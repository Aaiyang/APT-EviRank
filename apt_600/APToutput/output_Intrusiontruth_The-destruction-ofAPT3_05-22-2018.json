      "locator": {
        "page": 1,
        "section": "body",
        "sentence_id": "p1_s4"
      },
      "text": "It was the first time that the Chinese Intelligence Services had been conclusively linked to an APT and followed similar revelations, years previously, linking People’s Liberation Army (PLA) Unit 61398 to APT1.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
