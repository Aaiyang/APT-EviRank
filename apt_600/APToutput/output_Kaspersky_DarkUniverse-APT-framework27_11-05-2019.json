      "locator": {
        "page": 3,
        "section": "body",
        "sentence_id": "p3_s15"
      },
      "text": "This module looks for traffic from the following processes: outlook.exe;",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_38",
      "evidence_type": "report_text",
      "report_id": "Kaspersky_DarkUniverse-APT-framework27(11-05-2019)",
      "locator": {
