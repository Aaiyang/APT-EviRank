      "evidence_type": "report_text",
      "report_id": "Symantec_Dragonfly-Western-energy-sector-targeted(09-06-2017)",
      "locator": {
        "page": 3,
        "section": "body",
        "sentence_id": "p3_s1"
      },
      "text": "and Turkey were also among the countries targeted by Dragonfly in its earlier campaign, though the focus on organizations in Turkey does appear to have increased dramatically in this more recent campaign.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_8",
      "evidence_type": "report_text",
