      "evidence_type": "report_text",
      "report_id": "Symantec_Dragonfly-Western-energy-sector-targeted(09-06-2017)",
      "locator": {
        "page": 3,
        "section": "body",
        "sentence_id": "p3_s9"
      },
      "text": "In one instance, after a victim visited one of the compromised servers, Backdoor.Goodor was installed on their machine via PowerShell 11 days later.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
