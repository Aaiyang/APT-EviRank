        "section": "body",
        "sentence_id": "p1_s5"
      },
      "text": "Symantec customers are protected against the activities of the Dragonfly group.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
