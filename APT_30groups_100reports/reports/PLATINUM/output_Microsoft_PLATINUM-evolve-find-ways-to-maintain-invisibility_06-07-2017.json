      "locator": {
        "page": 4,
        "section": "body",
        "sentence_id": "p4_s2"
      },
      "text": "The new SOL protocol within the PLATINUM file-transfer tool makes use of the AMT Technology SDK’s Redirection Library API ( imrsdk.dll ).",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
