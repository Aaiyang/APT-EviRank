      "locator": {
        "page": 4,
        "section": "body",
        "sentence_id": "p4_s3"
      },
      "text": "The file Ins64.exe was used to deploy the HIGHNOON backdoor on the system.",
      "language": "en",
      "confidence": 0.95,
      "note": "narrative sentence evidence",
      "source": "document"
    },
    {
      "id": "ev_18",
      "evidence_type": "report_text",
